{
  "compilerOptions": {
    "declaration": true,
    "erasableSyntaxOnly": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ESNext", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "removeComments": true,
    "sourceMap": true,
    "strict": true,
    "target": "es2022",
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": true,
    "outDir": "dist",
    "skipLibCheck": true,
    "sourceRoot": "."
  },
  "include": ["src", "test", "*.ts"],
  "exclude": ["node_modules"]
}
